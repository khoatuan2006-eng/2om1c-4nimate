{
  "name": "story-workflow-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "script:check": "node --test script-analysis/*.test.mjs",
    "script:analyze": "node script-analysis/cli.mjs",
    "script:preview:ep02": "vite --config script-analysis/EP02/shot-preview/vite.config.mjs",
    "series:try": "node simple-scene/author-series.mjs",
    "preview": "node simple-scene/start-preview.mjs",
    "series:try:check": "node simple-scene/series.test.mjs",
    "assets:auto": "node scripts/auto-assets.mjs",
    "assets:auto:check": "node --test backend/tests/auto-assets.test.mjs",
    "scene:try": "node simple-scene/build.mjs && node simple-scene/server.mjs",
    "scene:try:check": "node simple-scene/verify.mjs",
    "start": "node server.mjs",
    "frontend": "node server.mjs",
    "backend": "node backend/server.mjs",
    "all": "node -e \"import('child_process').then(cp => { cp.spawn('node', ['server.mjs'], { stdio: 'inherit' }); cp.spawn('node', ['backend/server.mjs'], { stdio: 'inherit' }); })\"",
    "build:asset-hub": "vite build -c vite.asset-hub.config.ts",
    "typecheck:asset-hub": "tsc --noEmit",
    "film:try:author": "node simple-scene/author-film.mjs --edge-audio",
    "film:try:check": "node simple-scene/film-compiler.test.mjs && node simple-scene/verify.mjs",
    "film:try:studio": "node simple-scene/prepare-studio.mjs && node ../motion_intro/node_modules/@remotion/cli/remotion-cli.js studio simple-scene/native-entry.tsx --config=simple-scene/remotion.config.ts --port=3013 --no-open --disable-git-source",
    "film:try:anchors": "python simple-scene/analyze-anchors.py",
    "film:try:movement": "node simple-scene/author-movement-test.mjs",
    "film:try:movement:check": "node simple-scene/actor-placement.test.mjs",
    "foundation:check": "node simple-scene/foundation-check.mjs",
    "video:edit": "vite --config visual-editor/vite.config.mjs",
    "video:edit:check": "npm.cmd run video:edit:test && tsc -p visual-editor/tsconfig.json",
    "video:edit:dev": "vite --config visual-editor/vite.config.mjs",
    "video:edit:build": "vite build --config visual-editor/vite.config.mjs",
    "video:edit:start": "node visual-editor/runtime-server.mjs",
    "video:edit:test": "node --test --test-concurrency=4 visual-editor/*.test.mjs",
    "video:edit:e2e": "npm.cmd run video:edit:build && playwright test -c visual-editor/playwright.config.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@remotion/lottie": "^4.0.515",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-virtual": "^3.14.11",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
