{
  "name": "doyin-motion-series",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc",
    "series:validate": "node scripts/validate-series.mjs && node scripts/validate-preview-workflow.mjs && node scripts/validate-production-manifests.mjs && node scripts/validate-layout-assets.mjs && node scripts/validate-continuity-layouts.mjs",
    "assets:search": "node ../asset_browser/search-assets.mjs",
    "assets:record-gap": "node scripts/record-asset-gap.mjs",
    "assets:validate-manifests": "node scripts/validate-production-manifests.mjs",
    "assets:web-ingest": "node scripts/ingest-web-media.mjs",
    "assets:alpha": "python scripts/remove-checkerboard-alpha.py",
    "assets:geometry": "python scripts/analyze-asset-geometry.py",
    "assets:geometry-scene": "node scripts/prepare-scene-geometry.mjs",
    "assets:geometry-verify": "node scripts/verify-asset-geometry.mjs",
    "assets:verify-geometry": "node scripts/verify-asset-geometry.mjs",
    "pipeline:status": "node scripts/preview-workflow-status.mjs",
    "scene:work": "node scripts/scene-work-status.mjs",
    "scene": "node scripts/scene-command.mjs",
    "scene:context": "node scripts/scene-context.mjs",
    "scene:patch": "node scripts/scene-patch.mjs",
    "scene:fast-pass": "node scripts/scene-fast-pass.mjs",
    "scene:edit": "node scripts/scene-edit-session.mjs",
    "scene:check-changed": "node scripts/scene-check-changed.mjs",
    "scene:validate-fast": "node scripts/validate-scene-fast.mjs",
    "scene:checkpoint": "node scripts/scene-checkpoint.mjs",
    "scene:preview-lock": "node scripts/lock-preview-scene.mjs",
    "scene:preflight-create": "node scripts/create-preflight-manifest.mjs",
    "scene:preview-inspect": "node scripts/preview-inspect.mjs",
    "preview:worker:start": "node scripts/preview-worker-control.mjs start",
    "preview:worker:status": "node scripts/preview-worker-control.mjs status",
    "preview:worker:stop": "node scripts/preview-worker-control.mjs stop",
    "preview:worker:prewarm": "node scripts/preview-worker-control.mjs prewarm",
    "scene:preview-playback-record": "node scripts/record-preview-playback.mjs",
    "scene:preview-reopen": "node scripts/reopen-preview-scene.mjs",
    "scene:compile": "node scripts/core/scaffold-scene.mjs",
    "scene:retime-cues": "node scripts/compile-semantic-cues.mjs",
    "scene:subtitle-guard": "node scripts/apply-subtitle-spatial-guard.mjs",
    "scene:solve-layout": "node scripts/solve-semantic-layout.mjs",
    "scene:layout-override-proposal": "node scripts/create-layout-override-proposal.mjs",
    "scene:update-hashes": "node scripts/update-scene-dependency-hashes.mjs",
    "series:lock": "node scripts/validate-series.mjs --write-lock",
    "series:sync-quality-gates": "node scripts/sync-quality-gates.mjs series/episodes/EP001/episode.json",
    "render:scene-review": "node scripts/render-scene-review.mjs",
    "render:native-batch": "node scripts/render-native-batch.mjs",
    "audio:scene-mix": "node scripts/mix-scene-audio.mjs",
    "scene:approve-user": "node scripts/confirm-user-scene-approval.mjs",
    "scene:invalidate": "node scripts/invalidate-scene-approval.mjs",
    "tts:ep001": "powershell -ExecutionPolicy Bypass -File scripts/generate-narration.ps1 -EpisodePath series/episodes/EP001/episode.json",
    "render:story-preview": "remotion render src/index.ts KawasakiStory renders/kawasaki-story-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "render:story-directed-preview": "remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-directed-review-phim-new.mp4 --codec=h264 --crf=28 --scale=0.5 --concurrency=1",
    "render:story-mai-md-preview": "remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-mai-md-preview.mp4 --codec=h264 --crf=28 --scale=0.5 --concurrency=1",
    "render:ep001-r7-preview": "remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r7-cinematic-preview.mp4 --codec=h264 --crf=27 --scale=0.5 --concurrency=4",
    "render:ep001-r7-final": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r7-cinematic-final.mp4 --codec=h264 --crf=18 --concurrency=4",
    "render:ep001-r8-preview": "remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r8-cinematic-preview.mp4 --codec=h264 --crf=27 --scale=0.5 --concurrency=4",
    "render:ep001-r8-final": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r8-cinematic-final.mp4 --codec=h264 --crf=18 --concurrency=4",
    "render:ep001-r9-style-master": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r9-style-master.mp4 --codec=h264 --crf=18 --concurrency=4",
    "render:ep001-r10-style-master": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r10-style-master.mp4 --codec=h264 --crf=18 --concurrency=4",
    "render:ep001-r21-gated-master": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-ep001-r21-gated-master.mp4 --codec=h264 --crf=18 --concurrency=4",
    "render:story-final": "node scripts/assert-release-ready.mjs && remotion render src/index.ts KawasakiStory renders/kawasaki-story-final.mp4 --codec=h264 --crf=18",
    "render:trailer-preview": "remotion render src/index.ts HacTrieuTrailer renders/hac-trieu-trailer-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "render:trailer-final": "remotion render src/index.ts HacTrieuTrailer renders/hac-trieu-trailer-final.mp4 --codec=h264 --crf=18",
    "render:wide-preview": "remotion render src/index.ts HacTrieuWide renders/hac-trieu-wide-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "render:wide-final": "remotion render src/index.ts HacTrieuWide renders/hac-trieu-wide-final.mp4 --codec=h264 --crf=18",
    "render:preview": "remotion render src/index.ts HacTrieu renders/hac-trieu-preview.mp4 --codec=h264 --crf=28 --scale=0.5",
    "render:final": "remotion render src/index.ts HacTrieu renders/hac-trieu-final.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.515",
    "@remotion/bundler": "4.0.515",
    "@remotion/renderer": "4.0.515",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remotion": "4.0.515"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.19 <23"
  },
  "packageManager": "npm@10.9.3"
}
